# ===================================================================
# CareGuard AI - Server Environment Configuration Template
# คัดลอกไฟล์นี้เป็น .env แล้วตั้งค่าให้ตรงกับเซิร์ฟเวอร์ของคุณ
# ===================================================================

# Server Configuration
PORT=3000
HOST=0.0.0.0

# Database Configuration (MySQL / MariaDB)
MYSQL_HOST=localhost
MYSQL_PORT=3306
MYSQL_USER=your_db_user
MYSQL_PASSWORD=your_db_password
MYSQL_DATABASE=careguard_db

# Google Gemini AI (Optional - สำหรับระบบ AI Health Assistant)
GEMINI_API_KEY=YOUR_GEMINI_API_KEY

# Gmail Notification Configuration (SMTP)
GMAIL_USER=your-email@gmail.com
GMAIL_APP_PASSWORD=your-gmail-app-password
GMAIL_TO=emergency-contact@gmail.com

# Telegram Bot Notification Configuration
# Bot สำหรับ Hardware 1 (เช่น @CareGuardAI1_bot)
TELEGRAM_BOT_TOKEN=YOUR_TELEGRAM_BOT_TOKEN_HW1
# Bot สำหรับ Hardware 2 (เช่น @CareGuardAI2_bot)
TELEGRAM_BOT_TOKEN_H2=YOUR_TELEGRAM_BOT_TOKEN_HW2
# Chat ID สำหรับรับการแจ้งเตือน
TELEGRAM_CHAT_ID=YOUR_TELEGRAM_CHAT_ID

# Wi-Fi Geolocation Token (Unwired Labs / LocationIQ)
UNWIRED_TOKEN=YOUR_UNWIRED_TOKEN
